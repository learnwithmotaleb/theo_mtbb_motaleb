{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "http://10.10.28.192:6050",
        "EXPO_PUBLIC_API_BASE_URL": "http://10.10.28.192:6050/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.gestlio.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gestlio.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.gestlio.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gestlio.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
