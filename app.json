{
  "expo": {
    "name": "Gestlio",
    "slug": "gestlio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gestlio",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon1.png",

    "ios": {
      "icon": "./assets/images/icon1.png",
      "bundleIdentifier": "com.gestlio.app"
    },

    "android": {
      "versionCode": 4,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gestlio.app",
      "icon": "./assets/images/icon1.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon1.png",
        "backgroundColor": "#F5F5F5"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon1.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "android": {
            "image": "./assets/images/homeLogo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Gestlio to access your camera."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "919ad7dc-8643-49c6-94b7-94fff56214ba"
      }
    },

    "owner": "learnwithmotaleb"
  }
}