{
  "expo": {
    "name": "Gestlio",
    "slug": "gestlio",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "scheme": "gestlio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon1.png",
      "bundleIdentifier": "com.gestlio.app",
      "buildNumber": "22",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Gestlio needs access to your photos so you can add pictures of your accommodation and upload proof of a completed cleaning.",
        "NSCameraUsageDescription": "Gestlio needs access to your camera so you can photograph your accommodation and the result of a cleaning.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr",
          "en"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Gestlio does not use your location. This permission is never requested by the app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon1.png",
        "backgroundImage": "./assets/images/icon1.png",
        "monochromeImage": "./assets/images/icon1.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gestlio.app",
      "versionCode": 19,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon1.png"
    },
    "plugins": [
      "expo-router",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "devTeam": "85BK5MXPNB"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "buildReactNativeFromSource": true,
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "android": {
            "image": "./assets/images/homeLogo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gestlio needs access to your photos so you can add pictures of your accommodation and upload proof of a completed cleaning.",
          "cameraPermission": "Gestlio needs access to your camera so you can photograph your accommodation and the result of a cleaning."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {}
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "919ad7dc-8643-49c6-94b7-94fff56214ba"
      }
    },
    "owner": "learnwithmotaleb",
    "locales": {
      "fr": "./languages/fr.json",
      "en": "./languages/en.json"
    }
  }
}
