{
  "expo": {
    "name": "Gestlio",
    "slug": "gestlio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "scheme": "gestlio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.gestlio.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Gestlio needs access to your photos so you can add pictures of your accommodation and upload proof of a completed cleaning.",
        "NSCameraUsageDescription": "Gestlio needs access to your camera so you can photograph your accommodation and the result of a cleaning.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon1.png",
        "backgroundImage": "./assets/images/icon1.png",
        "monochromeImage": "./assets/images/icon1.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gestlio.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "android": {
            "image": "./assets/images/homeLogo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gestlio needs access to your photos so you can add pictures of your accommodation and upload proof of a completed cleaning.",
          "cameraPermission": "Gestlio needs access to your camera so you can photograph your accommodation and the result of a cleaning."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d31072d-35f3-430d-aa5d-aaeb4d270552"
      }
    },
    "owner": "ahsan-mahfuz"
  }
}
